#!/bin/dash
#
# POSIX shell scripts to install an entire Linux-like cmdline
# environment into the user's $HOME directory.
#
# usage: dotfileInstall [ --install | --check | --remove | --clean | --nuke ]
#
#        where --install: installs dotfiles into $HOME
#              --check:   checks what was installed
#              --remove:  generally removes what was installed
#              --clean:   like above but tries to conservatively clean things up
#              --nuke:    like above but deletes even manually installed things

# shellcheck shell=sh

export SCRIPT_NAME=allInstall
export DOTFILE_GIT_REPOS="${DOTFILE_GIT_REPOS:=$HOME/devel/dotfiles}"

## Before the actual split
export DEVEL_DOTFILES_GIT_REPO="${DEVEL_DOTFILES_GIT_REPO:=$DOTFILE_GIT_REPOS}"
export BASH_DOTFILES_GIT_REPO="${BASH_DOTFILES_GIT_REPO:=$DOTFILE_GIT_REPOS}"
export FISH_DOTFILES_GIT_REPO="${FISH_DOTFILES_GIT_REPO:=$DOTFILE_GIT_REPOS}"
export NVIM_DOTFILES_GIT_REPO="${NVIM_DOTFILES_GIT_REPO:=$DOTFILE_GIT_REPOS}"
## After the split, replace the above 4 commands with
# export DEVEL_DOTFILES_GIT_REPO="${DEVEL_DOTFILES_GIT_REPO:=$DOTFILE_GIT_REPOS/devel_dotfiles}"
# export BASH_DOTFILES_GIT_REPO="${BASH_DOTFILES_GIT_REPO:=$DOTFILE_GIT_REPOS/bash_dotfiles}"
# export FISH_DOTFILES_GIT_REPO="${FISH_DOTFILES_GIT_REPO:=$DOTFILE_GIT_REPOS/fish_dotfiles}"
# export NVIM_DOTFILES_GIT_REPO="${NVIM_DOTFILES_GIT_REPO:=$DOTFILE_GIT_REPOS/nvim_dotfiles}"

# Install sequentially

"$DEVEL_DOTFILES_GIT_REPO/bin/develInstall" "$@"
"$BASH_DOTFILES_GIT_REPO/bin/bashInstall" "$@"
"$FISH_DOTFILES_GIT_REPO/bin/fishInstall" "$@"
"$NVIM_DOTFILES_GIT_REPO/bin/nvimInstall" "$@"
